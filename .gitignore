# Build output
/server/casa
/bin/

# Test coverage report (uploaded by CI as an artifact, never committed)
coverage.out

# rapid fail files: a shrunk failure becomes a named example test instead
# (plan 1.7 decision 16)
server/**/testdata/rapid/

# Downloaded tools (scripts/fetch-verified.sh, scripts/cpd.sh)
.cache/

# Web dependencies (task 1.1b)
node_modules/

# Local environment files may hold secrets (ES §4)
.env*

# Superpowers SDD scratch workspace
.superpowers/

# The embedded web bundle, filled by make bundle-copy (ADR-030 item 3)
server/internal/webbundle/dist/*
!server/internal/webbundle/dist/.gitkeep
